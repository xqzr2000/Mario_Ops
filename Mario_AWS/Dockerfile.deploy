# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# MarioOps PRODUCTION image -- AWS EC2 / Batch on GPU.
#
#   build:            docker build -f Dockerfile.deploy -t marioops .
#   AWS GPU (g4dn):   docker run --rm --gpus all marioops
#   record a clip:    docker run --rm --gpus all marioops python play.py
#
# The CUDA runtime is BAKED IN: this image is built for the GPU target
# and is ~8 GB. Development happens in a Codespace off Dockerfile.develop
# (CPU torch, ~1 GB, editor tooling) -- see .devcontainer/devcontainer.json.
# The two share exactly one thing: requirements.txt. Nothing else about
# the dev environment can leak into production.
#
# It still RUNS on a host with no GPU (torch reports cuda unavailable and
# resolve_device() falls back to CPU), which is what makes
# `docker run --rm marioops` a valid pre-push check of the real artifact.
# You just pay 8 GB for the privilege, so do routine CPU work in the
# Codespace instead.
#
# Base image ships torch 2.3.1 + CUDA 12.1 + cuDNN 8 on Python 3.10 --
# the same interpreter generation the Colab training runs used, and the
# environment gym 0.25.2 / nes-py are known-good on.
#
# EC2 HOST PREREQUISITES (the image cannot check these for you):
#   * Root volume >= 100 GB. This base image is ~8 GB; Amazon Linux
#     2023's default 8 GiB root volume cannot even complete the pull.
#   * nvidia-container-toolkit + a driver supporting CUDA 12.1 (>= 530)
#     for --gpus all. Use the Deep Learning AMI or the ECS
#     GPU-optimized AMI; a bare AMI has neither.
#   * On Batch/ECS: memory >= 24 GB when REPLAY_CAPACITY=200000 (the
#     buffer alone is 11.3 GB). The cgroup OOM killer does NOT run the
#     finally block, so an under-provisioned job loses its checkpoint.
#   * On Batch/ECS: stopTimeout 60, so the SIGTERM handler below has
#     time to write and sync the final checkpoint.
#   * An instance/task IAM role with S3 + cloudwatch:PutMetricData.
#     boto3 picks it up automatically -- no keys in the image.
# ---------------------------------------------------------------------------
FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

# ffmpeg: play.py's primary encode path (H.264/yuv420p clips that
# preview in browsers and S3). Without it the code falls back to
# OpenCV mp4v with a warning -- and those clips will NOT play in
# browsers, so ffmpeg is effectively required, not optional.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependencies before source: this layer is cached until
# requirements.txt changes, so code-only edits rebuild in seconds.
#
# build-essential exists only long enough for pip to compile nes-py's
# C++ extension, then is purged IN THE SAME LAYER so it never bloats
# the final image. (Dockerfile.develop deliberately KEEPS it -- a dev
# container needs to be able to pip install again.)
#
# TWO PACKAGES ARE DELIBERATELY ABSENT, both commonly listed for nes-py:
#
#   python3-dev  supplies Python.h for the extension build -- but this
#                base is CONDA-based and already ships headers at
#                /opt/conda/include/python3.10/, which is what pip
#                actually compiles against. Installing Debian's
#                python3-dev would add a SECOND, unrelated interpreter
#                whose headers are never used.
#
#   libsdl2-dev  not required, headless or not. nes-py's setup.py
#                declares its Extension with its own include dir and NO
#                `libraries` argument, so it links nothing external;
#                rendering is pyglet (a pip dep, OpenGL not SDL),
#                imported lazily so it never loads without a viewer.
COPY requirements.txt .
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && pip install --no-cache-dir -r requirements.txt \
 && apt-get purge -y build-essential \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# Source last (changes most often). Explicit paths, not `COPY . .`,
# so nothing outside the real runtime surface can sneak into the image
# even if .dockerignore drifts -- notably .devcontainer/ and tools/,
# which exist for the Codespace and have no business in production.
COPY config.py train.py play.py ./
COPY mario_agent/ mario_agent/
COPY cloud/ cloud/

# Non-root user. Artifact dirs are pre-created and owned by it because
# config.py's defaults (checkpoints_7_action_g99/ logs/ runs/) are
# relative paths under WORKDIR -- mount a volume here for local
# persistence, or set MARIOOPS_S3_BUCKET and let the cloud sync own
# persistence. Both lineage folders are pre-created; train.py also
# mkdir-s whatever CHECKPOINT_DIR resolves to at runtime.
RUN useradd --create-home mario \
 && mkdir -p checkpoints_7_action checkpoints_7_action_g99 logs runs \
 && chown -R mario:mario /app
USER mario

# PYTHONUNBUFFERED: every print reaches `docker logs` / CloudWatch
# immediately, not just the ones with flush=True.
#
# MARIOOPS_DEVICE=auto: cuda when `--gpus all` makes a GPU visible,
# cpu otherwise. On this image auto should resolve to cuda in
# production -- if a Batch job logs "device: cpu", the container is not
# seeing the GPU (missing --gpus all, or a Batch job definition without
# a GPU resource requirement) and you are paying g4dn rates for CPU
# training. Set MARIOOPS_DEVICE=cuda to make that fail fast instead.
#
# NOTE: OMP_NUM_THREADS is deliberately NOT set here. Capping it to 1
# to free cores for the emulators sounds right and is badly wrong on
# the CPU target: with device=cpu the learner's conv2d forward/backward
# IS CPU compute, it sits synchronously between step_async and
# step_wait, and single-threading it makes it the blocking stage.
# Measured on an 8-core host, 8 envs: 35 steps/s with default threads,
# 16.5 with OMP_NUM_THREADS=1. train.py now picks the thread count
# from the resolved DEVICE instead (see configure_torch_threads),
# overridable with -e TORCH_THREADS=N.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MARIOOPS_DEVICE=auto

# EXEC FORM IS LOAD-BEARING. Shell form would make /bin/sh PID 1, and
# sh does not forward SIGTERM -- so the signal sent by spot reclaim,
# `docker stop`, and Batch job termination would never reach train.py's
# SIGTERM->SystemExit handler, and the finally-block final checkpoint
# sync would silently never run. Exec form makes python itself PID 1.
CMD ["python", "train.py"]
