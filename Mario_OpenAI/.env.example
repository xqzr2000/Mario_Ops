# Copy to .env for local runs. `.env` is gitignored at the repo root
# (`.env.example` is explicitly re-included, which is why this file is
# tracked and that one is not).
#
# In a Codespace you do NOT need this file: set OPENAI_API_KEY as a
# Codespaces secret instead and it arrives as an environment variable
# with nothing written to disk.

OPENAI_API_KEY=sk-...

# Optional overrides -- all have defaults in config.py.
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_API_STYLE=responses
# OPENAI_REASONING_EFFORT=low
# OPENAI_MAX_OUTPUT_TOKENS=2000
# MAX_DECISIONS=60
# SCREEN_UPSCALE=3
